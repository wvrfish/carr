# Smartcar OAuth credentials
# Get these from https://dashboard.smartcar.com
SMARTCAR_CLIENT_ID=your_client_id_here
SMARTCAR_CLIENT_SECRET=your_client_secret_here

# The URL Smartcar will redirect to after OAuth
# In development: http://localhost:3000/api/callback
# In production: https://your-vercel-domain.vercel.app/api/callback
SMARTCAR_REDIRECT_URI=http://localhost:3000/api/callback

# Your frontend URL (used for CORS and post-auth redirect)
# In development: http://localhost:3000
# In production: https://your-frontend-domain.com
FRONTEND_URL=http://localhost:3000

# Set to "true" to use Smartcar's test mode (simulated vehicles)
SMARTCAR_TEST_MODE=true
